# Case Vault server secrets. Copy to apps/casevault/.env ON THE SERVER ONLY. Never commit .env.
DOMAIN=casevault.example.com          # public domain (DNS A record -> server, or Cloudflare Tunnel)
PUBLIC_URL=https://casevault.example.com
POSTGRES_PASSWORD=                    # long random string
SECRET_KEY=                           # long random string (cookies, magic links, certificate links)
VAULT_ADMIN_TOKEN=                    # same value as VAULT_ADMIN_TOKEN in Puzzle Forge .env
VAULT_ANSWER_KEY=                     # same value as VAULT_ANSWER_KEY in Puzzle Forge .env (HMAC key)

# Cloudflare Turnstile (captcha) — dash.cloudflare.com -> Turnstile -> Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Klaviyo — Settings -> API keys -> private key (scopes: profiles, lists, events, subscriptions: write)
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=                      # id of the list "Case Vault Newsletter"

# Shopify — app with Admin API scopes read_orders (+ read_all_orders), write_discounts
SHOPIFY_SHOP=                         # <name>.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_STORE_URL=                    # public shop URL shown next to coupons

# Etsy Open API v3 (optional; without it Etsy orders are verified by CSV import)
ETSY_API_KEY=                         # keystring (Etsy may ask for "keystring:shared_secret")
ETSY_SHOP_ID=
ETSY_TOKEN_FILE=data/etsy_token.json  # OAuth tokens (refreshed automatically)
ETSY_SHOP_URL=                        # public shop URL shown next to Etsy coupons

# Telegram alerts (solved cases, low coupon stock, provider failures)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel alternative (profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
