# /opt/casevault/<prod|staging>/.env on the server (mode 600). NEVER commit a filled copy.
# `casevault init` creates both files with fresh random secrets; you fill in the provider keys.
# ---- deployment
INSTANCE=prod                          # prod | staging
INSTANCE_DIR=/opt/casevault/prod
ENV_FILE=/opt/casevault/prod/.env
CASEVAULT_VERSION=0.2.0                # image tag = git tag casevault-v0.2.0
GHCR_OWNER=thailytran
DOMAIN=casevault.halosparkinc.com
STAGING_DOMAIN=staging.casevault.halosparkinc.com
ACME_EMAIL=                            # Let's Encrypt notices (your e-mail)
CADDYFILE=Caddyfile                    # or Caddyfile.cloudflare-origin
BACKUP_HOUR=3                          # UTC
BACKUP_REMOTE=                         # rclone remote:path (optional, `casevault upload on`)
POSTGRES_PASSWORD=
# ---- app
PUBLIC_URL=https://casevault.halosparkinc.com
SECRET_KEY=
VAULT_ADMIN_TOKEN=                     # = Puzzle Forge VAULT_ADMIN_TOKEN (prod) / VAULT_STAGING_ADMIN_TOKEN
VAULT_ANSWER_KEY=                      # = Puzzle Forge VAULT_ANSWER_KEY (prod) / VAULT_STAGING_ANSWER_KEY
TRUST_CLOUDFLARE=0                     # 1 only behind the Cloudflare proxy
SECURE_COOKIES=1
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_STORE_URL=
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_TOKEN_FILE=/app/data/etsy_token.json
ETSY_SHOP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
