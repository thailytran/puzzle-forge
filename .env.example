# Copy to .env (dev) — the VM installer writes /etc/puzzle-forge/forge.env (mode 600). Never commit.
# Environment: dev | test | prod. test = DevSkuProvider (DEV- SKUs), Case Vault staging/mock, low AI budget.
FORGE_ENV=dev
# FORGE_DATA_DIR=/var/lib/puzzle-forge   # output/, data/forge.db, data/config (default: current dir)
# FORGE_CONFIG_DIR=/etc/puzzle-forge     # secrets.enc + secret.key (API keys from the web UI)
FORGE_WEB_HOST=127.0.0.1                 # forge web: 127.0.0.1 or the Tailscale IP (100.x.y.z) only
FORGE_WEB_PORT=8710
FORGE_BACKUP_REMOTE=                     # rclone remote, e.g. gdrive:puzzle-forge-backups (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LLM providers (needed from phase P2; optional before that)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FORGE_LLM_PROVIDER=anthropic

# Paths (relative to the repo root unless absolute)
FORGE_OUTPUT_DIR=output
FORGE_DB_PATH=data/forge.db

# Optional: explicit path to the typst binary (default: found on PATH)
FORGE_TYPST_BIN=

# HALOSPARK Product Hub (SKU from the shared counter). HUB_URL = hooks base of the Portal,
# e.g. https://<portal-domain>/hooks/product-hub ; token = Product Hub "X-Hub-Token".
FORGE_SKU_PROVIDER=             # hub | dev (default: hub; dev in FORGE_ENV=test; prod refuses dev)
HUB_URL=
HUB_TOKEN=

# Case Vault (docs/CASEVAULT.md). The website itself has its own apps/casevault/.env on the server.
VAULT_URL=                    # e.g. https://casevault.example.com  (empty = registrations stay queued)
VAULT_DOMAIN=                 # printed on the last page + QR, e.g. casevault.example.com
VAULT_ADMIN_TOKEN=            # same value as on the server
VAULT_ANSWER_KEY=             # HMAC key for answers / Book Codes, same value as on the server

# Case Vault STAGING (used when FORGE_ENV=test). VAULT_STAGING_URL=mock writes payloads to data/vault_mock/.
VAULT_STAGING_URL=
VAULT_STAGING_DOMAIN=
VAULT_STAGING_ADMIN_TOKEN=
VAULT_STAGING_ANSWER_KEY=
